[Unit]
Description=SmartZone occupancy control API and dashboard (smartzone.anshu.tech)
After=network-online.target
Wants=network-online.target

[Service]
User=smartzone
Group=smartzone
WorkingDirectory=/opt/smartzone/backend
EnvironmentFile=/var/lib/smartzone/smartzone.env
Environment=SMARTZONE_DB=/var/lib/smartzone/smartzone.db
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/smartzone/.venv/bin/python -m uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8020 --proxy-headers
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/smartzone

[Install]
WantedBy=multi-user.target
